      "typeVersion": 2.1,
      "position": [720, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://187.77.116.14:8080/api/analytics/sync",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
