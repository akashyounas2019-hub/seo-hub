        "nodeCredentialType": "googleAnalyticsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"dateRanges\": [{\"startDate\": \"28daysAgo\", \"endDate\": \"today\"}],\n  \"metrics\": [{\"name\": \"activeUsers\"}, {\"name\": \"sessions\"}, {\"name\": \"conversions\"}, {\"name\": \"eventCount\"}],\n  \"dimensions\": [{\"name\": \"pagePath\"}]\n}",
        "options": {}
      },
      "id": "node-fetch-ga4",
