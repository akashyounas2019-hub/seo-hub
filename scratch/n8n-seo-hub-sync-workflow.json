      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 350]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://mybusinessbusinessinformation.googleapis.com/v1/accounts/default/locations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleBusinessProfileOAuth2Api",
        "options": {}
      },
      "id": "node-fetch-gbp",
      "name": "Google Business Profile API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 500]
