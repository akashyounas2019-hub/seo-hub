        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSearchConsoleOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"startDate\": \"2026-07-24\",\n  \"endDate\": \"2026-08-20\",\n  \"dimensions\": [\"query\"],\n  \"rowLimit\": 25\n}",
        "options": {}
      },
      "id": "node-fetch-gsc",
