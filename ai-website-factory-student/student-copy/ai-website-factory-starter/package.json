{
  "name": "gyl-platform",
  "version": "0.1.0",
  "private": true,
  "description": "GYL Platform — multi-site SEO control plane for Dubai-based cleaning & maintenance services.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "db:reset": "rm -rf .data/pglite && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "user:add": "node --env-file=.env --import tsx src/db/cli.ts user:add",
    "user:assign": "node --env-file=.env --import tsx src/db/cli.ts user:assign",
    "user:list": "node --env-file=.env --import tsx src/db/cli.ts user:list",
    "site:list": "node --env-file=.env --import tsx src/db/cli.ts site:list",
    "ai:audit": "node --env-file=.env --import tsx src/scripts/audit.ts",
    "health:import": "node --env-file=.env --import tsx src/scripts/health-import.ts",
    "health:sweep": "node --env-file=.env --import tsx src/scripts/health-sweep.ts",
    "health:digest": "node --env-file=.env --import tsx src/scripts/health-digest.ts",
    "plugin:publish": "node --env-file=.env --import tsx src/scripts/publish-plugin.ts",
    "plugin:build": "bash scripts/build-plugin-zip.sh",
    "ranks:sweep": "node --env-file=.env --import tsx src/scripts/keyword-rank-sweep.ts",
    "gbp:queue": "node --env-file=.env --import tsx src/scripts/queue-gbp-drafts.ts",
    "push:scan": "node --env-file=.env --import tsx src/scripts/push-trigger-scan.ts",
    "ai:digest": "node --env-file=.env --import tsx src/scripts/digest.ts",
    "materialize:templates": "node --env-file=.env --import tsx src/scripts/materialize-templates.ts",
    "sync:gsc": "node --env-file=.env --import tsx src/scripts/sync-gsc.ts",
    "sync:ga4": "node --env-file=.env --import tsx src/scripts/sync-ga4.ts",
    "seo:scan": "node --env-file=.env --import tsx src/scripts/seo-scan.ts",
    "seo:digest": "node --env-file=.env --import tsx src/scripts/seo-digest.ts",
    "build:screenshots": "node --env-file=.env --import tsx src/scripts/build-research-screenshots.ts",
    "seo:outcomes": "node --env-file=.env --import tsx src/scripts/seo-outcome-tracker.ts",
    "sync:inventory": "node --env-file=.env --import tsx src/scripts/sync-inventory.ts",
    "scoring:compute": "node --env-file=.env --import tsx src/scripts/scoring-compute.ts",
    "weekly:report": "node --env-file=.env --import tsx src/scripts/weekly-report.ts",
    "patterns:detect": "node --env-file=.env --import tsx src/scripts/pattern-detect.ts",
    "screenshots:capture": "node --env-file=.env --import tsx src/scripts/screenshot-capture.ts",
    "qa:run": "node --env-file=.env --import tsx src/scripts/qa-run.ts",
    "health:check": "node --env-file=.env --import tsx src/scripts/health-check.ts",
    "prune:recordings": "node --env-file=.env --import tsx src/scripts/prune-recordings.ts",
    "prune:chat-sessions": "node --env-file=.env --import tsx src/scripts/prune-chat-sessions.ts",
    "publish:scheduled": "node --env-file=.env --import tsx src/scripts/publish-scheduled.ts",
    "run:scheduled-workflows": "node --env-file=.env --import tsx src/scripts/run-scheduled-workflows.ts",
    "rubric:audit": "node --env-file=.env --import tsx src/scripts/run-local-seo-rubric.ts",
    "agent:reset:onpage": "node --env-file=.env --import tsx src/scripts/reset-onpage-agent.ts",
    "agent:reset:builtin": "node --env-file=.env --import tsx src/scripts/reset-builtin-agents.ts",
    "agent:schedules:tick": "node --env-file=.env --import tsx src/scripts/run-agent-schedules.ts",
    "agent:schedules:install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File worker/install-schedule-runner.ps1",
    "agent:schedules:uninstall:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File worker/install-schedule-runner.ps1 -Uninstall",
    "build:page-perf": "node --env-file=.env --import tsx src/scripts/build-page-performance.ts",
    "worker": "node --env-file=.env.worker worker/claude-worker.mjs",
    "worker:install": "bash worker/install-launchd.sh",
    "worker:install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File worker/install-scheduled-task.ps1",
    "worker:uninstall:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File worker/install-scheduled-task.ps1 -Uninstall",
    "worker:status:windows": "powershell -NoProfile -Command \"Get-ScheduledTaskInfo -TaskName GYL-Claude-Worker | Format-List\"",
    "worker:logs:windows": "powershell -NoProfile -Command \"Get-Content .data/worker-logs/worker.out.log -Tail 40\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@electric-sql/pglite": "^0.2.17",
    "axe-core": "^4.10.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.36.4",
    "geist": "^1.7.1",
    "lucide-react": "^1.16.0",
    "next": "^14.2.18",
    "nodemailer": "^6.10.1",
    "pg": "^8.20.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.23",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
