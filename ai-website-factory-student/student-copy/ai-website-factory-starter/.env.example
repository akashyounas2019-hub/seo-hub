# ── AI Website Factory — local environment ─────────────────────────────
# Copy to `.env`  →  cp .env.example .env   then fill the values below.

# Required. Any long random string:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Keyword research runs through the hosted Factory proxy — the SEMrush key is
# NEVER in this codebase. The instructor gives you the class token to paste here.
FACTORY_API_URL=http://localhost:3001
FACTORY_TOKEN=paste-the-class-token-from-your-instructor

# Must match the worker's GYL_WORKER_SECRET (see .env.worker.example).
GYL_WORKER_SECRET=dev-worker-secret

# OPTIONAL — server-side AI (vision/image steps). The $0 Claude Code worker does
# NOT need this. Paste here or in the dashboard at /admin/settings.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Database is embedded PGlite (./.data/pglite) — no Postgres, no cloud, nothing to set.
