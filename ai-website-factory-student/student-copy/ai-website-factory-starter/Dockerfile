# syntax=docker/dockerfile:1.7

# ── Stage 1 — install deps ──────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
# libc-compat is needed for some native modules under musl
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json* ./
# Skip Playwright's browser download — we install Alpine's `chromium` package
# in the runner stage and point Playwright at it via executablePath.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# Use `npm install` (not `npm ci`) so a missing/out-of-sync lock file doesn't
# block the build. Lock file is regenerated inside the layer.
RUN npm install --no-audit --no-fund

# ── Stage 2 — build Next.js (standalone output) ─────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Build-time stubs — real values come from runtime env in the runner stage.
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ── Stage 3 — small runtime image ───────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Chromium for Playwright (qa:run, screenshots:capture, build:screenshots).
# Using Alpine's system chromium avoids the ~150MB Playwright browser
# download + matches the musl libc the rest of the runtime uses.
RUN apk add --no-cache \
      chromium \
      nss \
      freetype \
      harfbuzz \
      ca-certificates \
      ttf-freefont \
      font-noto-emoji
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 --ingroup nodejs nextjs

# Next.js standalone output: minimal node_modules + server.js
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# We need tsx + drizzle + the source for the seed/migrate CLI scripts run via
# `docker exec` after boot. Keep these alongside the standalone server.
COPY --from=builder --chown=nextjs:nodejs /app/src ./src
COPY --from=builder --chown=nextjs:nodejs /app/drizzle ./drizzle
COPY --from=builder --chown=nextjs:nodejs /app/drizzle.config.ts ./drizzle.config.ts
COPY --from=builder --chown=nextjs:nodejs /app/tsconfig.json ./tsconfig.json
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules

# Phase-3 recording storage. The health check probes `./.data/recordings` for
# writability — without this pre-create the runtime user can't mkdir under
# /app and /api/health returns 503 even though the rest of the app is fine.
# Same story for screenshots/ (P3 visual regression) + build-research/ (chat
# tool that captures competitor screenshots).
RUN mkdir -p /app/.data/recordings /app/.data/screenshots/build-research \
    && chown -R nextjs:nodejs /app/.data

USER nextjs
EXPOSE 3000

# server.js is generated by next build with output:'standalone'
CMD ["node", "server.js"]
