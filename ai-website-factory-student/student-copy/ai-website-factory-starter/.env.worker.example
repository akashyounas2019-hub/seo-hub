# ── Claude Code worker (the $0 job engine) ─────────────────────────────
# Copy to `.env.worker`  →   cp .env.worker.example .env.worker
# Then run:  npm run worker
#
# The worker RUNS the agents (design research, keyword research, content
# writing) using YOUR Claude Code subscription — $0 per token. Keep it
# running in a second terminal while you work. It adapts to each project's
# niche automatically.

GYL_PORTAL_URL=http://localhost:3001

# Must match the worker secret seeded into your local DB (default below).
# It is created for you by `npm run db:reset`.
GYL_WORKER_SECRET=dev-worker-secret

# Path to your Claude Code CLI. Find it with:  which claude
GYL_CLAUDE_BIN=claude
GYL_CLAUDE_MAX_TURNS=25
